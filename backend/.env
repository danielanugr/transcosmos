APP_NAME="Task Management API"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# Database Configuration (Switch to mysql when running MySQL server)
DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=task_management
DB_USERNAME=root
DB_PASSWORD=

# JWT Configuration
JWT_SECRET=super-secret-jwt-key-minimum-32-characters-long
JWT_TTL=86400

# File Uploads (50MB default limit)
MAX_FILE_SIZE=52428800

# Queue Worker Settings
QUEUE_MAX_ATTEMPTS=3
QUEUE_RETRY_DELAY=5
