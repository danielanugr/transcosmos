{
  "name": "trans-cosmos/task-management-api",
  "description": "Task Management REST API with real-time support, file processing, and background jobs",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.2"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    },
    "files": [
      "src/Utils/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "php tests/run_tests.php",
    "seed": "php database/Seeder.php",
    "worker": "php worker.php",
    "start": "php -S 127.0.0.1:8000 -t public"
  }
}
